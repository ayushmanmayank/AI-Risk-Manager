# Copy this file to .env and adjust if the defaults collide with
# something else on your machine. All of these have working defaults
# baked into docker-compose.yml, so .env is optional for a first run.

# Host ports Docker publishes the two services on.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Origins the backend will accept cross-origin requests from (comma-
# separated). Must include wherever the frontend is actually reachable
# FROM YOUR BROWSER -- localhost + a published port, never a Docker-
# internal service hostname like http://backend:8000, since the browser
# runs on your host machine, not inside the compose network. The default
# already covers both `npm run dev` (5173) and the Dockerized frontend
# (3000, or whatever FRONTEND_PORT you set above).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Baked into the frontend build (Vite env vars are compile-time, not
# read at container runtime) -- must be a URL your BROWSER can reach,
# i.e. localhost + BACKEND_PORT above, never http://backend:8000.
VITE_API_BASE_URL=http://localhost:8000/api/v1
